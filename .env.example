# Copier ce fichier en .env.local et remplir les valeurs. NE JAMAIS committer .env.local.

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Cloudflare R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Trigger.dev
TRIGGER_SECRET_KEY=

# IA
ASSEMBLYAI_API_KEY=
ANTHROPIC_API_KEY=
ELEVENLABS_API_KEY=

# Remotion Lambda (AWS)
REMOTION_AWS_ACCESS_KEY_ID=
REMOTION_AWS_SECRET_ACCESS_KEY=
REMOTION_AWS_REGION=

# Paiements
FEDAPAY_SECRET_KEY=
FEDAPAY_WEBHOOK_SECRET=
PAWAPAY_API_TOKEN=

# Services
RESEND_API_KEY=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_POSTHOG_KEY=

# Sentry (errors) and PostHog (analytics). Leave empty to disable.
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# Supabase. Local/test values must point to the DEV project (semgen-dev), never production.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only secret: never prefix with NEXT_PUBLIC_, never share.
SUPABASE_SECRET_KEY=
